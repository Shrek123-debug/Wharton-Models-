# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.cache/
*.egg-info/

# Data caches (regenerated by the pipeline).
# NOTE: portfolio_model/data/offline/ is deliberately NOT ignored — those committed price
# snapshots are what let every model run with zero network on a fresh clone.
portfolio_model/data/cache/
portfolio_model/data/raw/
portfolio_model/data/processed/
portfolio_model/data/input/uploads/

# Generated artifacts. Every file under outputs/ is reproducible from an input workbook plus the
# config, so committing them only makes the repo churn on each run. The web run history under
# outputs/web/runs/ also contains the holdings of whoever pressed Run - that must never be pushed.
portfolio_model/outputs/

# OS
.DS_Store

# Project spec (local reference only)
portfolio_modeling_agent_spec.md
